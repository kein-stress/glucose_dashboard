# URL твоего инстанса Nightscout, без слэша на конце
NIGHTSCOUT_URL=https://your-nightscout-instance.example.com

# API_SECRET из настроек Nightscout (используется как токен для чтения entries)
# Если инстанс публичный для чтения — можно оставить пустым
NIGHTSCOUT_API_SECRET=

PORT=3000

# Пароль для входа в дашборд (хэш, не сам пароль).
# Сгенерировать: npm run hash-password -- "<твой пароль>"
AUTH_PASSWORD_HASH=

# Секрет для подписи cookie сессии. Сгенерировать один раз и не менять —
# иначе все активные сессии будут сбрасываться при каждом перезапуске/деплое.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Если несколько устройств шлют sgv в один Nightscout (например, дубли от разных
# BG source плагинов AAPS) — отфильтровать по конкретному device. Оставь пустым, чтобы не фильтровать.
NIGHTSCOUT_DEVICE=
